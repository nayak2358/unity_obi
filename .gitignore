# This is a standard .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/

# Visual Studio cache/solution files
/[Ee]xtras/
[Oo]ffice/
.vs/
.gradle/
export/

# Autogenerated VS/MonoDevelop/JetBrains Rider projects
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Generated
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored if the asset itself is ignored
!*[Ee]xternal-Dependency-Manager*

# Autogenerated Android gradle projects
/[Aa]ndroid/[Ll]ibrary/